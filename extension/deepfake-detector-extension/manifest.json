{
  "manifest_version": 3,
  "name": "Multimodal Deepfake Detector",
  "version": "1.0.0",
  "description": "Right-click any image, video, or audio on the web to check it for AI-generated manipulation using vision, audio, and fusion analysis.",
  "permissions": [
    "contextMenus",
    "sidePanel",
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Deepfake Detector",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
